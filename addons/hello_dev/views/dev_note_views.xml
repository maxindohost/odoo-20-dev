<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dev_note_view_list" model="ir.ui.view">
        <field name="name">dev.note.list</field>
        <field name="model">dev.note</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="dev_note_view_form" model="ir.ui.view">
        <field name="name">dev.note.form</field>
        <field name="model">dev.note</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" type="object" string="Tandai Selesai"
                            invisible="state == 'done'" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dev_note_action" model="ir.actions.act_window">
        <field name="name">Dev Notes</field>
        <field name="res_model">dev.note</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="dev_note_menu_root" name="Dev Notes" action="dev_note_action" sequence="10"/>
</odoo>
